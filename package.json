{
  "name": "engineering-fieldnotes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "docs:check": "python scripts/check_site.py",
    "site:test": "node --test scripts/site.test.mjs",
    "lab:browser": "node examples/browser_long_tasks/run.mjs",
    "lab:query-plans": "python examples/query_plans/lab.py",
    "lab:inventory": "python examples/inventory_concurrency/lab.py",
    "lab:recovery": "python examples/backup_recovery/lab.py",
    "lab:overload": "python examples/overload_control/lab.py",
    "lab:connections": "node examples/connection_lifecycle/lab.mjs",
    "lab:ai-tools": "python examples/ai_tool_boundaries/lab.py",
    "lab:memory": "python examples/memory_governance/lab.py"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "vitepress": "1.6.4",
    "vue": "3.5.44"
  }
}
